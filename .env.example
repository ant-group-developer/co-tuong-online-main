# Sao chép thành .env (cùng thư mục) rồi điền. Một file dùng chung cho npm run dev, deploy Hosting và Docker. Giá trị lấy từ Firebase Console → Project settings → Your apps → Web → firebaseConfig.
# Web config là công khai theo thiết kế. KHÔNG đặt service-account key vào đây.

# Port mở web trên máy: http://localhost:3000
WEB_PORT=3000

VITE_APP_NAME=Cờ Tướng Online
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# Vùng Cloud Functions (trùng functions/src/config.ts)
VITE_FUNCTIONS_REGION=asia-southeast1
# (Tùy chọn) App Check: site key reCAPTCHA Enterprise
# VITE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=
