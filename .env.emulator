# Chế độ emulator: `npm run dev:emu` (apps/web) – không cần dự án Firebase thật.
# Ghi đè MỌI khóa Firebase để không lẫn giá trị project thật từ .env.
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_PROJECT_ID=demo-xiangqi
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-xiangqi.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://demo-xiangqi-default-rtdb.firebaseio.com
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FUNCTIONS_REGION=asia-southeast1
VITE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=
