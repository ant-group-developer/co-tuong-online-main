# Sao chép thành functions/.env (được Firebase CLI nạp khi deploy). Không chứa bí mật.

# Vùng của instance Realtime Database. Mặc định asia-southeast1 (Singapore).
# Chỉ đổi nếu bạn đã tạo RTDB ở vùng khác (ví dụ us-central1, europe-west1).
# RTDB_REGION=asia-southeast1

# Bắt buộc App Check cho mọi callable (bật sau khi web đã cấu hình App Check).
# ENFORCE_APP_CHECK=true
